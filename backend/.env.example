# OpenAI
OPENAI_API_KEY=sk-your-api-key-here

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data
COLLECTION_NAME=rag_documents

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.1

# Server
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000
